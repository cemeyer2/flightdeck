{
  "name": "FlightDeck Tabs",
  "description": "Tells FlightDeck on this Mac which tab runs in which Chrome process. It only reports; it never reads or changes pages.",
  "version": "1.0.1",
  "manifest_version": 3,
  "key": "",
  "background": { "service_worker": "background.js" },
  "permissions": ["tabs", "webNavigation", "nativeMessaging"],
  "externally_connectable": { "ids": [] },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
